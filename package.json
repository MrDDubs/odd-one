{
  "name": "allys-stream-hub",
  "version": "1.0.0",
  "description": "Ally's Stream Hub - Unified TikTok Live Game Suite, Launcher & Stream Overlay",
  "main": "electron/main.js",
  "bin": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron": "electron .",
    "build-exe": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-all": "electron-builder -mw"
  },
  "build": {
    "appId": "com.mrddubs.allystreamhub",
    "productName": "Allys Stream Hub",
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "allys-stream-hub.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal",
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal",
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games"
    },
    "asarUnpack": [
      "node_modules/**/*",
      "games/**/*"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "tiktok-live-connector": "^2.4.4",
    "ws": "^8.17.0"
  },
  "keywords": [
    "tiktok",
    "tikfinity",
    "game-hub",
    "stream-overlay",
    "odd-one-out",
    "think-like-ally"
  ],
  "author": "Mr D Dubs",
  "license": "ISC",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "socket.io-client": "^4.8.3"
  }
}
