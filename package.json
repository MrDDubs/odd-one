{
  "name": "allys-odd-one-out",
  "version": "1.0.0",
  "description": "Ally's Odd One Out - TikTok Live interactive game with TikFinity integration and Admin Panel",
  "main": "electron/main.js",
  "bin": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron": "electron .",
    "build-exe": "electron-builder --win",
    "build-mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.mrddubs.oddoneout",
    "productName": "Allys Odd One Out",
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "allys-odd-one-out.exe"
    },
    "mac": {
      "target": "dmg"
    },
    "asarUnpack": [
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "ws": "^8.17.0"
  },
  "keywords": [
    "tiktok",
    "tikfinity",
    "game",
    "odd-one-out"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "socket.io-client": "^4.8.3"
  }
}
